# Supabase -- Project Settings > API and > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS -- never expose, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Used for magic-link redirects. http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pricing engine. Gemini is primary, Groq is the fallback when Gemini rate-limits.
# Both optional: without either, pricing falls back to comparables then category
# defaults, so the app still runs end to end.
GEMINI_API_KEY=
GROQ_API_KEY=

# Transactional email (Phase 4).
RESEND_API_KEY=
